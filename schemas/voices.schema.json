{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solo-dev-room/gemini-tts-batch/schemas/voices.schema.json",
  "title": "Gemini TTS Batch Voices",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "characters"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/character"
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "voice"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "base_style": {
          "type": "string"
        }
      }
    }
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solo-dev-room/gemini-tts-batch/schemas/episode.schema.json",
  "title": "Gemini TTS Batch Episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "output", "scenes"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_dir"],
      "properties": {
        "relative_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker", "text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "speaker": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string"
        },
        "voice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lines"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    }
  }
}

